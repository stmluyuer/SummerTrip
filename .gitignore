# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc
/game/*.rpa
/game/bytecode.rpyb

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old
/screenshot*.png

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/memory.txt
/profile_screen.txt
/save_dump.txt
/text_overflow.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Distribution builds.
/*-dists/
/*-pc.zip
/*-pc/

# Python caches.
__pycache__/
*.py[cod]

# Local environment and signing credentials.
/.env
/.env.*
!/.env.example
/update.pem
*.keystore
*.jks

# Operating system and editor files.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
